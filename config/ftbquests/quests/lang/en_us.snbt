	quest.67E6603F58B2AF21.quest_desc: [
		"Craft all the items above to get started."
		""
		"Anytime you see a &6Blaze Burner&r in a Ponder, you use a &cBurner&r instead, as there are no &6Blazes&r in this world."
		""
		"Remember you can left click on one to see the recipes for crafting it, you can also pin the recipe to your favorites on the left to find it more easily with \"A\""
	]
	quest.67E6603F58B2AF21.quest_subtitle: "Hand crafting is horribly inefficient"
	quest.67E6603F58B2AF21.title: "Improving the Yield"
	quest.6813CCFC650B56DB.quest_subtitle: "Lets you make your own paintings. Google the mod"
	quest.6813CCFC650B56DB.title: "Immersive Paintings"
	quest.68299A797C7FACFF.quest_desc: [
		"Gives you &9information&r about the components placed"
		""
		"&6When looking at blocks:&r"
		"&9Stress impact&r or &9Capacity&r."
		"Other blocks reveal information such as &6item and fluid&r content."
	]
	quest.68299A797C7FACFF.quest_subtitle: "[Click to read]"
	quest.68E04C8B816FFBB4.quest_desc: [
		"&6SU&r (&6Stress Units&r) is the kind of power used in the Create mod and its addons."
		""
		"Machines use &6stress&r to function, working faster and using an amount of stress proportional to the &cRPM&r (Revolutions Per Minute) "
		""
		"You can see the &6SU&r and &4RPM&r of a machine while wearing the &6Engineer's Goggles&r."
		""
		"You can measure the &6SU&r and &4RPM&r of a whole network with a Speedometer and Stressometer."
		""
		"The maximum rotation speed of a component is 256 RPM. Any more and components added to speed up further, such as a cogwheel, will break."
	]
	quest.68E04C8B816FFBB4.quest_subtitle: "Powering things with Create"
	quest.68E04C8B816FFBB4.title: "Stress Units"
	quest.69356D152DD0AC71.quest_subtitle: "You should read the mod page for this one"
