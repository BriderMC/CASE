	quest.04C1848040DF5079.quest_desc: [
		""
		"Drop the Iron/Zinc and Andesite into the Basin and then hold down right mouse while looking at the Hand Crank to turn it"
		"{@pagebreak}"
		"The &cBurner&r must be fueled for this to work, any recipe with &6\"Heated\"&r and the &6Blaze Burner&r under it in the EMI recipe view will require that."
		""
		"This recipes works with Dusts or Crushed versions of Iron/Zinc and Andesite. So you can use a Mechanical Belt Grinder or the Millstone for automating it."
	]
