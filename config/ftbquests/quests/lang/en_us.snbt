	quest.0EFBFE00008E8EC5.quest_desc: [
		"Start by Heating &eSulfur Dust&r in a 2x2 Chem Vat, that will create Sulfur Dioxide. "
		""
		"Oxidize it further into Sulfur Trioxide by adding Iron Dust."
		""
		"Then mix Sulfur Trioxide and Water to create, Sulfuric Acid"
	]
