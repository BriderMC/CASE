	quest.699E75A23211D2AE.quest_subtitle: "Hold W while hovering over something from Create to learn about it"
	quest.699E75A23211D2AE.title: "Ponder"
	quest.69C31EEEA8F12E30.quest_desc: [
		"There are lots of new hotkeys added by mods, I suggest just through the whole list and setting any that you think you'll use."
