	quest.61C78689A49D77DF.quest_desc: [
		"This modpack uses the mod \"Picky Wheels\" it nerfs Water Wheels, making them work better in more sensible locations."
		""
		"To get the full amount of power from them, water must be present on only one of the waterwheel's side of contact, and the water source must be connected to a large body of water inside a river biome."
		""
		"You can still place them anywhere but they will give you less SU"
	]
	quest.61C78689A49D77DF.quest_subtitle: "I hope you live near a River"
	quest.61C78689A49D77DF.title: "Water Power"
	quest.624BB84ECB2E5E9A.quest_desc: ["When used in the &cLiquid Burner&r, &eGasoline&r and &7LPG&r are both are able to give \"Super Heated\""]
	quest.624BB84ECB2E5E9A.quest_subtitle: "Another Fuel"
	quest.6274267ACDC05A8A.quest_subtitle: "Gives \"Extra\" Resources"
