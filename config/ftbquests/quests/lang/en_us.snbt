	quest.4D4BD8D84E0534D0.title: "Electrum is the Core resource for Electricity"
	quest.4D4D4D4D4D4D4D4D.quest_desc: [
		"Place a \"Electrode Cable Connector\" on top of the Electrode Holder, and another on a source of &eFE&r, such as a Accumulator. "
		""
		"Right click it with a wrench to swap Push/Pull modes and connect them together with a \"Electrode Power Cable\", if power is flowing the Vat should say \"&aOperational&r\""
		""
		"Normal wires and connectors will not work"
		""
		"UI will say \"Not Operational\" after restarting the game but it will keep working if it was before."
	]
	quest.4D4D4D4D4D4D4D4D.title: "Powering the Electrode Holders"
